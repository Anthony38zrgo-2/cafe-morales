{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SiteConfig v2",
  "type": "object",
  "required": ["site", "theme", "sections"],
  "properties": {
    "site": {
      "type": "object",
      "required": ["brand"],
      "properties": {
        "brand": {
          "type": "object",
          "required": ["name", "shortName"],
          "properties": {
            "name": { "type": "string" },
            "shortName": { "type": "string" },
            "tagline": { "type": "string" },
            "description": { "type": "string" }
          }
        },
        "seo": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "themeColor": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" }
          }
        },
        "contact": {
          "type": "object",
          "properties": {
            "phone": { "type": "string" },
            "phoneDisplay": { "type": "string" },
            "email": { "type": "string" },
            "address": { "type": "string" },
            "whatsappDefaultMessage": { "type": "string" }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "required": ["preset", "palette"],
      "properties": {
        "preset": { "enum": ["cafetal", "minimal", "vibrante"] },
        "palette": { "enum": ["forest", "denim-orange", "earth", "ocean", "sunset", "graphite", "wine", "midnight", "sand", "custom"] },
        "colors": {
          "type": "object",
          "properties": {
            "ink": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
            "muted": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
            "surface": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
            "surfaceAlt": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
            "brand": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
            "brandDark": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
            "accent": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" }
          }
        },
        "typography": { "enum": ["sans-display", "display-heavy", "elegant", "mono"] },
        "radius": { "enum": ["sm", "md", "xl", "2xl", "full"] }
      }
    },
    "navigation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "href"],
        "properties": {
          "label": { "type": "string" },
          "href": { "type": "string" },
          "section": { "type": "string" }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "enabled"],
        "properties": {
          "id": { "enum": ["header", "hero", "catalog", "about", "benefits", "contact", "footer", "floating-contact"] },
          "enabled": { "type": "boolean" },
          "order": { "type": "number" },
          "variant": { "type": "string" },
          "props": { "type": "object" }
        }
      }
    },
    "order": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "units": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
