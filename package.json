{
  "name": "cafe-morales",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:github": "vite build --mode github",
    "build:sites": "vite build --base / --outDir dist/client --emptyOutDir false && node scripts/prepare-sites.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run test && npm run build",
    "predeploy": "npm run build:github",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "vite": "^8.1.1",
    "vitest": "^4.0.18"
  }
}
